# ─────────────────────────────────────────────────────────────
# azure-creator — environment configuration
# Copy to `.env.local` and fill in when you want real deploys.
# The app runs fully in mock mode with NONE of these set.
# ─────────────────────────────────────────────────────────────

# Executor mode: "mock" (default, no Azure, no cost) or "terraform" (real).
EXECUTOR_MODE=mock

# ── Azure credentials (only needed when EXECUTOR_MODE=terraform) ──
# Preferred in Azure: leave these blank and use a Managed Identity
# (DefaultAzureCredential picks it up automatically). For local real
# runs, a Service Principal works:
AZURE_SUBSCRIPTION_ID=
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=

# Default region used when a deployment doesn't specify one.
AZURE_DEFAULT_LOCATION=westeurope

# Path to the `terraform` binary (real mode only).
TERRAFORM_BIN=terraform
